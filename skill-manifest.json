{
  "skill_name": "chatgpt-ppt",
  "version": "0.4.0",
  "target_surface": "ChatGPT Chat",
  "load_mode": "transient",
  "entrypoint": "CHATGPT.md",
  "core_files": [
    "CHATGPT.md",
    "skill-manifest.json",
    "SKILL.md"
  ],
  "progressive_load": {
    "outline": [
      "docs/workflow-gates.md",
      "docs/outline-style-sample.md",
      "docs/assets-and-files.md"
    ],
    "style": [
      "references/style-catalog.md",
      "docs/outline-style-sample.md",
      "docs/text-repairability.md",
      "docs/style-reuse.md"
    ],
    "sample_and_generation": [
      "docs/image-generation.md",
      "docs/prompting.md",
      "docs/text-repairability.md",
      "examples/sample_slide_prompt.example.md",
      "examples/slide_prompt.example.md",
      "examples/slide_prompt_with_asset.example.md"
    ],
    "qa_and_assembly": [
      "docs/qa-and-assembly.md",
      "docs/text-repairability.md",
      "scripts/validate_project.cjs",
      "scripts/assemble_ppt.cjs"
    ],
    "state_validation": [
      "references/deck_state.schema.json",
      "examples/deck_state.example.json"
    ]
  },
  "style_library": [
    "references/清爽专业风.md",
    "references/创意杂志风.md",
    "references/电子墨水杂志风.md",
    "references/数据仪表盘风.md",
    "references/科研答辩风.md",
    "references/复古扁平插画风.md",
    "references/手绘技术解释风.md",
    "references/手绘白板风.md",
    "references/温暖手工风.md",
    "references/麦肯锡风格.md",
    "references/党政红风格.md",
    "references/教学课件风.md"
  ],
  "style_loading_rule": "Use style-catalog.md to shortlist. Load only the detailed style reference files needed for the shortlist; after user selection, keep the selected detailed reference loaded for visual_spec and generation.",
  "session_policy": {
    "freeze_loaded_snapshot": true,
    "silent_midtask_refresh": false,
    "prefer_tag_or_commit_for_reproducibility": true
  },
  "optional_resources": {
    "style_preview_gallery": "references/style-preview-gallery.md",
    "upstream_visual_showcase": "examples/upstream-showcase.md"
  }
}
